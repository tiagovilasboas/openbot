{
  "name": "openbot",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/check-build.mjs",
    "start": "next start",
    "lint": "eslint .",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.mjs\" \"*.{json,mjs,ts}\"",
    "typecheck": "node scripts/check-typecheck.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "test": "node --experimental-strip-types --test scripts/check-docs.test.mjs src/features/chat/respond-to-message.test.ts",
    "check": "npm run docs:check && npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "prepare": "husky"
  },
  "dependencies": {
    "@ionic/core": "9.0.10",
    "@ionic/react": "9.0.10",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3"
  },
  "lint-staged": {
    "*.{js,mjs,ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{css,json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
