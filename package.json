{
  "name": "openbot",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "node scripts/check-build.mjs",
    "start": "next start -H 127.0.0.1",
    "lint": "eslint .",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.mjs\" \"*.{json,mjs,ts}\"",
    "typecheck": "node scripts/check-typecheck.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "test": "node --experimental-strip-types --test \"scripts/**/*.test.mjs\" \"src/**/*.test.ts\"",
    "brand:draw": "node --experimental-strip-types scripts/draw-brand-mark.mjs",
    "check": "npm run docs:check && npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "prepare": "husky",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "@heroui/react": "3.2.7",
    "@heroui/styles": "3.2.7",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  },
  "lint-staged": {
    "*.{js,mjs,ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{css,json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
